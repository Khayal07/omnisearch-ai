/* OmniSearch AI — dark glassmorphism theme */

QWidget#overlayRoot {
    background: transparent;
}

QFrame#card {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(38, 40, 48, 250),
        stop: 0.55 rgba(28, 29, 36, 250),
        stop: 1 rgba(22, 23, 29, 250)
    );
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 16px;
}

QWidget#headerBar {
    background: transparent;
}

QLabel#brandDot {
    background-color: #6c8cff;
    border-radius: 5px;
}

QLabel#brandLabel {
    color: #e9eaf0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.4px;
}

QLineEdit#searchBar {
    background-color: rgba(255, 255, 255, 10);
    color: #f0f0f4;
    border: 1px solid rgba(255, 255, 255, 16);
    border-radius: 11px;
    padding: 10px 12px;
    font-size: 15px;
    selection-background-color: #3a57d6;
    selection-color: #ffffff;
}

QLineEdit#searchBar:focus {
    border: 1px solid #6c8cff;
    background-color: rgba(108, 140, 255, 18);
}

QLineEdit#searchBar:hover:not(:focus) {
    border: 1px solid rgba(255, 255, 255, 30);
}

QLineEdit#searchBar::placeholder {
    color: rgba(240, 240, 244, 100);
}

QPushButton#newChatButton {
    background: rgba(108, 140, 255, 16);
    color: #bcc8ff;
    border: 1px solid rgba(108, 140, 255, 70);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#newChatButton:hover {
    background: rgba(108, 140, 255, 28);
    color: #ffffff;
    border: 1px solid #6c8cff;
}

QPushButton#newChatButton:pressed {
    background: rgba(108, 140, 255, 40);
}

QLabel#statusLabel {
    color: #8f9bb3;
    font-size: 12px;
    padding-right: 4px;
}

QTextBrowser#streamOutput {
    background: rgba(0, 0, 0, 60);
    border: 1px solid rgba(255, 255, 255, 12);
    border-radius: 10px;
    color: #e6e7ec;
    font-size: 13px;
    selection-background-color: #3a57d6;
    selection-color: #ffffff;
    padding: 2px;
}

QTextBrowser#streamOutput QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px;
}

QTextBrowser#streamOutput QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 32);
    border-radius: 4px;
    min-height: 24px;
}

QTextBrowser#streamOutput QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 64);
}

QTextBrowser#streamOutput QScrollBar::add-line:vertical,
QTextBrowser#streamOutput QScrollBar::sub-line:vertical {
    height: 0;
}

QLabel#footerHint {
    color: rgba(240, 240, 244, 105);
    font-size: 11px;
}

QListView#historyList {
    background: rgba(255, 255, 255, 6);
    color: #e6e7ec;
    border: 1px solid rgba(255, 255, 255, 12);
    border-radius: 9px;
    font-size: 13px;
    padding: 3px;
}

QListView#historyList::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QListView#historyList::item:hover {
    background: rgba(255, 255, 255, 8);
}

QListView#historyList::item:selected {
    background: rgba(108, 140, 255, 70);
    color: #ffffff;
}

/* ---- Settings dialog -------------------------------------------- */

QDialog#settingsDialog {
    background-color: #1a1b21;
}

QLabel#dialogTitle {
    color: #f0f0f4;
    font-size: 17px;
    font-weight: 700;
}

QLabel#dialogSubtitle {
    color: #8f9bb3;
    font-size: 12px;
}

QLabel#sectionLabel {
    color: #6c8cff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding-top: 8px;
}

QDialog#settingsDialog QLabel {
    color: #c7ccd8;
}

QDialog#settingsDialog QLineEdit,
QDialog#settingsDialog QComboBox,
QDialog#settingsDialog QSpinBox,
QDialog#settingsDialog QDoubleSpinBox,
QDialog#settingsDialog QPlainTextEdit {
    background-color: rgba(255, 255, 255, 10);
    color: #f0f0f4;
    border: 1px solid rgba(255, 255, 255, 16);
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: #3a57d6;
    selection-color: #ffffff;
}

QDialog#settingsDialog QLineEdit:focus,
QDialog#settingsDialog QComboBox:focus,
QDialog#settingsDialog QSpinBox:focus,
QDialog#settingsDialog QDoubleSpinBox:focus,
QDialog#settingsDialog QPlainTextEdit:focus {
    border: 1px solid #6c8cff;
}

QDialog#settingsDialog QComboBox::drop-down {
    border: none;
    width: 22px;
}

QDialog#settingsDialog QComboBox QAbstractItemView {
    background-color: #22242c;
    color: #f0f0f4;
    border: 1px solid rgba(255, 255, 255, 16);
    border-radius: 8px;
    selection-background-color: rgba(108, 140, 255, 70);
}

QDialog#settingsDialog QPushButton {
    background-color: #26282f;
    color: #e6e7ec;
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QDialog#settingsDialog QPushButton:hover {
    background-color: #30333c;
    border: 1px solid rgba(255, 255, 255, 34);
}

QDialog#settingsDialog QPushButton#primaryButton {
    background-color: #4a6cf7;
    border: none;
    color: #ffffff;
}

QDialog#settingsDialog QPushButton#primaryButton:hover {
    background-color: #5a7bfa;
}

QDialog#settingsDialog QCheckBox {
    color: #c7ccd8;
}

QDialog#settingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 34);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 10);
}

QDialog#settingsDialog QCheckBox::indicator:checked {
    background-color: #4a6cf7;
    border: 1px solid #4a6cf7;
}

QDialog#settingsDialog QScrollArea {
    border: none;
    background: transparent;
}

/* ---- Menus / tray ----------------------------------------------- */

QMenu {
    background-color: #202127;
    color: #e6e7ec;
    border: 1px solid rgba(255, 255, 255, 22);
    border-radius: 9px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 20px 7px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: rgba(108, 140, 255, 80);
    color: #ffffff;
}

QMenu::item:disabled {
    color: rgba(230, 231, 236, 60);
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 18);
    margin: 5px 8px;
}

QToolTip {
    background-color: #202127;
    color: #e6e7ec;
    border: 1px solid rgba(255, 255, 255, 22);
    border-radius: 6px;
    padding: 5px 8px;
}