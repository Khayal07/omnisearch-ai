/* OmniSearch AI — dark theme
   Muted steel/slate palette. Deep ink (never pure black), hairline borders,
   custom scrollbars, restrained accent used only for focus/selection. */

QWidget#overlayRoot {
    background: transparent;
}

QFrame#card {
    background-color: #1d1f26;
    border: 1px solid rgba(255, 255, 255, 10);
    border-radius: 16px;
}

QWidget#headerBar {
    background: transparent;
}

QLabel#brandDot {
    background-color: #8a93a8;
    border-radius: 5px;
}

QLabel#brandLabel {
    color: #e8eaf0;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
}

QLineEdit#searchBar {
    background-color: rgba(255, 255, 255, 5);
    color: #f2f3f7;
    border: 1px solid rgba(255, 255, 255, 12);
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 15px;
    selection-background-color: rgba(138, 147, 168, 45);
    selection-color: #ffffff;
}

QLineEdit#searchBar:focus {
    border: 1px solid #8a93a8;
    background-color: rgba(138, 147, 168, 12);
}

QLineEdit#searchBar:hover:not(:focus) {
    border: 1px solid rgba(255, 255, 255, 24);
}

QLineEdit#searchBar::placeholder {
    color: rgba(232, 234, 240, 110);
}

QPushButton#newChatButton {
    background: rgba(138, 147, 168, 14);
    color: #c6cddc;
    border: 1px solid rgba(138, 147, 168, 60);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#newChatButton:hover {
    background: rgba(138, 147, 168, 24);
    color: #ffffff;
    border: 1px solid #8a93a8;
}

QPushButton#newChatButton:pressed {
    background: rgba(138, 147, 168, 36);
}

QLabel#statusLabel {
    color: #a6adbd;
    font-size: 11px;
    background: rgba(138, 147, 168, 14);
    border: 1px solid rgba(138, 147, 168, 40);
    border-radius: 9px;
    padding: 3px 10px;
}

QTextBrowser#streamOutput {
    background: rgba(255, 255, 255, 4);
    border: 1px solid rgba(255, 255, 255, 10);
    border-radius: 10px;
    color: #e4e6ec;
    font-size: 13px;
    selection-background-color: rgba(138, 147, 168, 45);
    selection-color: #ffffff;
    padding: 2px;
}

QLabel#footerHint {
    color: rgba(232, 234, 240, 100);
    font-size: 11px;
}

QListView#historyList {
    background: rgba(255, 255, 255, 4);
    color: #e4e6ec;
    border: 1px solid rgba(255, 255, 255, 10);
    border-radius: 9px;
    font-size: 13px;
    padding: 3px;
    outline: none;
}

QListView#historyList::item {
    padding: 2px 6px;
    border-radius: 8px;
}

QListView#historyList::item:hover {
    background: rgba(255, 255, 255, 7);
}

QListView#historyList::item:selected {
    background: rgba(138, 147, 168, 26);
}

QLabel#historyTitle {
    color: #e8eaf0;
    font-size: 13px;
    font-weight: 600;
}

QLabel#historyMeta {
    color: rgba(232, 234, 240, 100);
    font-size: 11px;
}

/* ---- Custom scrollbars (app-wide) ------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 14);
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 26);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 14);
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 26);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- Settings dialog -------------------------------------------- */

QDialog#settingsDialog {
    background-color: #1d1f26;
}

QLabel#dialogTitle {
    color: #f2f3f7;
    font-size: 17px;
    font-weight: 700;
}

QLabel#dialogSubtitle {
    color: #9aa1b2;
    font-size: 12px;
}

QLabel#sectionLabel {
    color: #8a93a8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding-top: 8px;
}

QDialog#settingsDialog QLabel {
    color: #c6cddc;
}

QDialog#settingsDialog QLineEdit,
QDialog#settingsDialog QComboBox,
QDialog#settingsDialog QSpinBox,
QDialog#settingsDialog QDoubleSpinBox,
QDialog#settingsDialog QPlainTextEdit {
    background-color: rgba(255, 255, 255, 5);
    color: #f2f3f7;
    border: 1px solid rgba(255, 255, 255, 14);
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: rgba(138, 147, 168, 45);
    selection-color: #ffffff;
}

QDialog#settingsDialog QLineEdit:focus,
QDialog#settingsDialog QComboBox:focus,
QDialog#settingsDialog QSpinBox:focus,
QDialog#settingsDialog QDoubleSpinBox:focus,
QDialog#settingsDialog QPlainTextEdit:focus {
    border: 1px solid #8a93a8;
}

QDialog#settingsDialog QComboBox::drop-down {
    border: none;
    width: 22px;
}

QDialog#settingsDialog QComboBox QAbstractItemView {
    background-color: #232630;
    color: #f2f3f7;
    border: 1px solid rgba(255, 255, 255, 14);
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(138, 147, 168, 30);
    selection-color: #ffffff;
    outline: none;
}

QDialog#settingsDialog QComboBox QAbstractItemView::item {
    border-radius: 6px;
    padding: 4px 8px;
}

QDialog#settingsDialog QPushButton {
    background-color: #262a33;
    color: #e4e6ec;
    border: 1px solid rgba(255, 255, 255, 16);
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QDialog#settingsDialog QPushButton:hover {
    background-color: #2e323d;
    border: 1px solid rgba(255, 255, 255, 26);
}

QDialog#settingsDialog QPushButton#primaryButton {
    background-color: #4a5060;
    border: none;
    color: #ffffff;
}

QDialog#settingsDialog QPushButton#primaryButton:hover {
    background-color: #565d70;
}

QDialog#settingsDialog QCheckBox {
    color: #c6cddc;
}

QDialog#settingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 5);
}

QDialog#settingsDialog QCheckBox::indicator:hover {
    border: 1px solid rgba(255, 255, 255, 46);
}

QDialog#settingsDialog QCheckBox::indicator:checked {
    background-color: #8a93a8;
    border: 1px solid #8a93a8;
}

QDialog#settingsDialog QScrollArea {
    border: none;
    background: transparent;
}

/* ---- Menus / tray ----------------------------------------------- */

QMenu {
    background-color: #232630;
    color: #e4e6ec;
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 9px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 20px 7px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: rgba(138, 147, 168, 26);
    color: #ffffff;
}

QMenu::item:disabled {
    color: rgba(232, 234, 240, 55);
}

QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 14);
    margin: 5px 8px;
}

QToolTip {
    background-color: #232630;
    color: #e4e6ec;
    border: 1px solid rgba(255, 255, 255, 18);
    border-radius: 6px;
    padding: 5px 8px;
}