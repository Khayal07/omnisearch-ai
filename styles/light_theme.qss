/* OmniSearch AI — light theme
   Muted steel/slate palette, mirrors the dark theme structure. */

QWidget#overlayRoot {
    background: transparent;
}

QFrame#card {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 rgba(255, 255, 255, 254),
        stop: 1 rgba(248, 250, 253, 254)
    );
    border: 1px solid rgba(15, 20, 35, 16);
    border-radius: 16px;
}

QWidget#headerBar {
    background: transparent;
}

QLabel#brandDot {
    background-color: #5b6478;
    border-radius: 5px;
}

QLabel#brandLabel {
    color: #23262e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
}

QLineEdit#searchBar {
    background-color: rgba(15, 20, 35, 4);
    color: #23262e;
    border: 1px solid rgba(15, 20, 35, 14);
    border-radius: 11px;
    padding: 10px 12px;
    font-size: 15px;
    selection-background-color: rgba(91, 100, 120, 28);
    selection-color: #ffffff;
}

QLineEdit#searchBar:focus {
    border: 1px solid #5b6478;
    background-color: rgba(91, 100, 120, 8);
}

QLineEdit#searchBar:hover:not(:focus) {
    border: 1px solid rgba(15, 20, 35, 30);
}

QLineEdit#searchBar::placeholder {
    color: rgba(35, 38, 46, 110);
}

QPushButton#newChatButton {
    background: rgba(91, 100, 120, 10);
    color: #4c5568;
    border: 1px solid rgba(91, 100, 120, 60);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#newChatButton:hover {
    background: rgba(91, 100, 120, 18);
    color: #2b3242;
    border: 1px solid #5b6478;
}

QPushButton#newChatButton:pressed {
    background: rgba(91, 100, 120, 28);
}

QLabel#statusLabel {
    color: #6a7284;
    font-size: 12px;
    padding-right: 4px;
}

QTextBrowser#streamOutput {
    background: rgba(15, 20, 35, 4);
    border: 1px solid rgba(15, 20, 35, 10);
    border-radius: 10px;
    color: #2b303c;
    font-size: 13px;
    selection-background-color: rgba(91, 100, 120, 28);
    selection-color: #ffffff;
    padding: 2px;
}

QLabel#footerHint {
    color: rgba(35, 38, 46, 105);
    font-size: 11px;
}

QListView#historyList {
    background: rgba(15, 20, 35, 4);
    color: #2b303c;
    border: 1px solid rgba(15, 20, 35, 10);
    border-radius: 9px;
    font-size: 13px;
    padding: 3px;
    outline: none;
}

QListView#historyList::item {
    padding: 6px 10px;
    border-radius: 6px;
}

QListView#historyList::item:hover {
    background: rgba(15, 20, 35, 6);
}

QListView#historyList::item:selected {
    background: rgba(91, 100, 120, 18);
    color: #1f2533;
}

/* ---- Custom scrollbars (app-wide) ------------------------------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(15, 20, 35, 22);
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(15, 20, 35, 35);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: rgba(15, 20, 35, 22);
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(15, 20, 35, 35);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: transparent;
}

/* ---- Settings dialog -------------------------------------------- */

QDialog#settingsDialog {
    background-color: #f7f8fb;
}

QLabel#dialogTitle {
    color: #23262e;
    font-size: 17px;
    font-weight: 700;
}

QLabel#dialogSubtitle {
    color: #6a7284;
    font-size: 12px;
}

QLabel#sectionLabel {
    color: #5b6478;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding-top: 8px;
}

QDialog#settingsDialog QLabel {
    color: #3d4554;
}

QDialog#settingsDialog QLineEdit,
QDialog#settingsDialog QComboBox,
QDialog#settingsDialog QSpinBox,
QDialog#settingsDialog QDoubleSpinBox,
QDialog#settingsDialog QPlainTextEdit {
    background-color: #ffffff;
    color: #23262e;
    border: 1px solid rgba(15, 20, 35, 16);
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: rgba(91, 100, 120, 28);
    selection-color: #ffffff;
}

QDialog#settingsDialog QLineEdit:focus,
QDialog#settingsDialog QComboBox:focus,
QDialog#settingsDialog QSpinBox:focus,
QDialog#settingsDialog QDoubleSpinBox:focus,
QDialog#settingsDialog QPlainTextEdit:focus {
    border: 1px solid #5b6478;
}

QDialog#settingsDialog QComboBox::drop-down {
    border: none;
    width: 22px;
}

QDialog#settingsDialog QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #23262e;
    border: 1px solid rgba(15, 20, 35, 16);
    border-radius: 8px;
    padding: 4px;
    selection-background-color: rgba(91, 100, 120, 20);
    selection-color: #1f2533;
    outline: none;
}

QDialog#settingsDialog QComboBox QAbstractItemView::item {
    border-radius: 6px;
    padding: 4px 8px;
}

QDialog#settingsDialog QPushButton {
    background-color: #ffffff;
    color: #3d4554;
    border: 1px solid rgba(15, 20, 35, 18);
    border-radius: 8px;
    padding: 8px 18px;
    font-weight: 600;
}

QDialog#settingsDialog QPushButton:hover {
    background-color: #eef1f6;
    border: 1px solid rgba(15, 20, 35, 32);
}

QDialog#settingsDialog QPushButton#primaryButton {
    background-color: #5b6478;
    border: none;
    color: #ffffff;
}

QDialog#settingsDialog QPushButton#primaryButton:hover {
    background-color: #6a748a;
}

QDialog#settingsDialog QCheckBox {
    color: #3d4554;
}

QDialog#settingsDialog QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid rgba(15, 20, 35, 28);
    border-radius: 4px;
    background-color: #ffffff;
}

QDialog#settingsDialog QCheckBox::indicator:hover {
    border: 1px solid rgba(15, 20, 35, 44);
}

QDialog#settingsDialog QCheckBox::indicator:checked {
    background-color: #5b6478;
    border: 1px solid #5b6478;
}

QDialog#settingsDialog QScrollArea {
    border: none;
    background: transparent;
}

/* ---- Menus / tray ----------------------------------------------- */

QMenu {
    background-color: #ffffff;
    color: #23262e;
    border: 1px solid rgba(15, 20, 35, 16);
    border-radius: 9px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 20px 7px 14px;
    border-radius: 6px;
}

QMenu::item:selected {
    background: rgba(91, 100, 120, 18);
    color: #1f2533;
}

QMenu::item:disabled {
    color: rgba(35, 38, 46, 65);
}

QMenu::separator {
    height: 1px;
    background: rgba(15, 20, 35, 14);
    margin: 5px 8px;
}

QToolTip {
    background-color: #ffffff;
    color: #23262e;
    border: 1px solid rgba(15, 20, 35, 16);
    border-radius: 6px;
    padding: 5px 8px;
}